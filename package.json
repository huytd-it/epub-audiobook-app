{
  "name": "epub-audiobook-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "tauri": "tauri",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "install:all": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
    "dev:desktop": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "build:desktop": "powershell -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "build:desktop:debug": "powershell -ExecutionPolicy Bypass -File scripts/build-desktop.ps1 -Debug",
    "build:desktop:clean": "powershell -ExecutionPolicy Bypass -File scripts/build-desktop.ps1 -Clean"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.3.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
